! Sample configuration for failover pools.
!
! The real servers of the virtual server form its primary pool, which
! is used while it achieves its quorum of 3, i.e. while at least 3 of
! its 4 real servers are live (all the real servers have the default
! weight of 1, so the quorum is a number of servers).
!
! If the primary pool does not achieve its quorum, failover pool 1 is
! used if at least 2 of its real servers are live. Failover pool 1 has
! a hysteresis of 1, so it first achieves its quorum once all 3 are
! live, and then keeps it until none of them are.
!
! If neither pool achieves its quorum, failover pool 2 is used. Its
! quorum is a weight: 10.0.3.1 has weight 2, so either that server on
! its own or both the others are needed.
!
! If no pool achieves its quorum, the sorry server is used.
!
! The real servers of all the pools are health checked all the time,
! and the pool in use changes as soon as the highest priority pool
! that achieves its quorum changes; for example, the primary pool is
! used again as soon as 3 of its servers are live.

virtual_server 10.0.0.1 80 {
  delay_loop 6
  lvs_sched rr
  lvs_method NAT
  protocol TCP
  quorum 3
  quorum_up "/usr/local/sbin/pool-notify.sh primary up"
  quorum_down "/usr/local/sbin/pool-notify.sh primary down"

  real_server 10.0.1.1 80 {
    TCP_CHECK {
      connect_timeout 3
    }
  }
  real_server 10.0.1.2 80 {
    TCP_CHECK {
      connect_timeout 3
    }
  }
  real_server 10.0.1.3 80 {
    TCP_CHECK {
      connect_timeout 3
    }
  }
  real_server 10.0.1.4 80 {
    TCP_CHECK {
      connect_timeout 3
    }
  }

  failover_pool 1 {
    quorum 2
    hysteresis 1
    quorum_up "/usr/local/sbin/pool-notify.sh 1 up"
    quorum_down "/usr/local/sbin/pool-notify.sh 1 down"

    real_server 10.0.2.1 80 {
      TCP_CHECK {
        connect_timeout 3
      }
    }
    real_server 10.0.2.2 80 {
      TCP_CHECK {
        connect_timeout 3
      }
    }
    real_server 10.0.2.3 80 {
      TCP_CHECK {
        connect_timeout 3
      }
    }
  }

  failover_pool 2 {
    quorum 2

    real_server 10.0.3.1 80 {
      weight 2
      TCP_CHECK {
        connect_timeout 3
      }
    }
    real_server 10.0.3.2 80 {
      TCP_CHECK {
        connect_timeout 3
      }
    }
    real_server 10.0.3.3 80 {
      TCP_CHECK {
        connect_timeout 3
      }
    }
  }

  sorry_server 10.0.4.1 80
}
